# Copy to .env and fill in your Grafana Cloud OTLP credentials.
# Find these under your Grafana Cloud stack's "OpenTelemetry" / "Configuration" page.

GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=

# Filled in automatically by scripts/setup.sh — the path to podman's
# Docker-compatible API socket as seen from inside the podman machine VM.
PODMAN_SOCK_PATH=/run/podman/podman.sock

# Overridden per-run by scripts/run-benchmark.sh; leave as-is.
ENABLE_OTEL=
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1
